yarn-error.log*
.pnpm-debug.log*

# ── Secrets and credentials ───────────────────────────────
# Never commit these. Service account keys, OAuth client secrets and
# local machine config all carry credentials or environment-specific
# values that do not belong in version control.
*.pem
*.key
*credentials*.json
*service-account*.json
client_secret*.json
.env
.env.*
!.env.example
config.local.toml

# ── Experiment Executor: local runtime state ──────────────
# Run logs, event spools and staged protocol scripts are per-machine
# artefacts. Logs sync to GCS by run ID; they are not repo content.
/var/
work_dir/
runs/
spool.db
spool.db-*
*.jsonl
!examples/**/*.jsonl

# Local deck and machine configuration are written at provisioning time
# and differ per lab computer.
deck.local.json
config.toml
!examples/**/config.toml

# ── Terraform / infra state ───────────────────────────────
*.tfstate
*.tfstate.*
.terraform/
.terraform.lock.hcl
*.tfvars
!*.tfvars.example

# ── Build and scratch ─────────────────────────────────────
*.log
tmp/
.tmp/
scratch/
_to_delete/
